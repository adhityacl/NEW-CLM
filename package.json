    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "glob": "^13.0.6",
    "googleapis": "^174.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
