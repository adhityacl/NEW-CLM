{
  "name": "silegal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:rbac": "tsx --test tests/rbac.test.ts",
    "test:e2e": "playwright test",
    "auth:generate": "better-auth generate --config ./server/auth.ts",
    "auth:migrate": "better-auth migrate --config ./server/auth.ts"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.9",
    "@google/genai": "^2.4.0",
