# AI Studio Environment Configuration
GEMINI_API_KEY=

# Authentication Configuration
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Optional: only needed to pin the app to one exact origin. Left unset, the
# app trusts whatever host/scheme the request actually arrives on, so it
# logs in correctly on localhost, a Codespace, or any deployed domain
# without editing this file.
# BETTER_AUTH_URL=https://clm.example.com
# Optional: extra trusted origins (comma separated), e.g. a separate front-end domain.
# TRUSTED_ORIGINS=

# Bootstrap Superuser. NOT disabled automatically in production: on a server use a strong
# password for the first start, then set SEED_DEMO_ADMIN=false (see README → Deploying).
SEED_DEMO_ADMIN=true
DEMO_ADMIN_EMAIL=admin@silegal.com
DEMO_ADMIN_PASSWORD=123456789

# Optional: Firebase for "Sign in with Google" on the login page. Leave empty
# to use the Google OAuth client (GOOGLE_CLIENT_ID / uploaded JSON) instead.
# From Firebase Console → Project Settings → General → Your apps → Web app.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Google OAuth & Service Account Integration
# Optional: a Superuser can instead upload the two JSON files from Google Cloud Console
# in the app ("Connect Google" / Settings → Google). Uploaded files take priority.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
