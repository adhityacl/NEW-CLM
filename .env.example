# AI Studio Environment Configuration
GEMINI_API_KEY=

# Authentication Configuration
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Bootstrap Superuser. NOT disabled automatically in production: on a server use a strong
# password for the first start, then set SEED_DEMO_ADMIN=false (see README → Deploying).
SEED_DEMO_ADMIN=true
DEMO_ADMIN_EMAIL=admin@silegal.com
DEMO_ADMIN_PASSWORD=123456789

# Google OAuth & Service Account Integration
# Optional: a Superuser can instead upload the two JSON files from Google Cloud Console
# in the app ("Connect Google" / Settings → Google). Uploaded files take priority.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
