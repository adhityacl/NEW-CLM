rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adhitcl@gmail.com' ||
        request.auth.token.role == 'admin'
      );
    }

    // Partners collection
    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(partnerId);
      allow delete: if isAdmin() && isValidId(partnerId);
    }

    // Contracts collection
    match /contracts/{contractId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(contractId);
      allow delete: if isAdmin() && isValidId(contractId);
    }

    // Insertion Orders collection
    match /insertionOrders/{ioId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(ioId);
      allow delete: if isAdmin() && isValidId(ioId);
    }

    // Activity Logs collection
    match /activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false; // immutable audit log
    }

    // Templates collection
    match /templates/{templateId} {
      allow read, write: if isSignedIn() && isValidId(templateId);
    }

    // Connection test collection
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
