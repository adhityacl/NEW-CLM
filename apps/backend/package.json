{
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "name": "@legalio/backend",
  "scripts": {
    "dev": "API_ONLY=true tsx watch src/server.ts",
    "dev:combined": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --alias:@legalio/shared=../../packages/shared/src --alias:@legalio/types=../../packages/types/src --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "node --max-old-space-size=2048 ../../node_modules/typescript/bin/tsc --noEmit",
    "auth:generate": "better-auth generate --config ./auth.config.ts",
    "auth:migrate": "better-auth migrate --config ./auth.config.ts"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.9",
    "@google/genai": "^2.4.0",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^174.0.1",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "google-auth-library": "^10.9.1",
    "@legalio/types": "*",
    "@legalio/shared": "*"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@legalio/ts-config": "*",
    "vite": "^6.2.3"
  }
}
