{
  "entities": {
    "Partner": {
      "title": "Partner",
      "description": "Represents a partner company or vendor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "contactPerson": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "driveFolderId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "category", "status"]
    },
    "Contract": {
      "title": "Contract",
      "description": "Master legal contract record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "contractNumber": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 250 },
        "partnerId": { "type": "string", "maxLength": 128 },
        "partnerName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "startDate": { "type": "string", "maxLength": 50 },
        "endDate": { "type": "string", "maxLength": 50 },
        "value": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["draft", "active", "expiring_soon", "expired", "terminated"] },
        "driveFileId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "contractNumber", "title", "partnerId", "status"]
    },
    "InsertionOrder": {
      "title": "InsertionOrder",
      "description": "Insertion order / Work order document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ioNumber": { "type": "string", "maxLength": 100 },
        "contractId": { "type": "string", "maxLength": 128 },
        "partnerId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 250 },
        "startDate": { "type": "string", "maxLength": 50 },
        "endDate": { "type": "string", "maxLength": 50 },
        "value": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "approved", "active", "completed", "cancelled"] },
        "driveFileId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "ioNumber", "partnerId", "status"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit activity logs for operations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "userName": { "type": "string", "maxLength": 150 },
        "userRole": { "type": "string", "maxLength": 50 },
        "actionType": { "type": "string", "maxLength": 50 },
        "module": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userEmail", "actionType", "module", "timestamp"]
    },
    "Template": {
      "title": "Template",
      "description": "Cooperation agreement custom template",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "contentId": { "type": "string" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "contentId"]
    }
  },
  "firestore": {
    "/templates/{templateId}": {
      "schema": "Template",
      "description": "Collection storing custom templates"
    },
    "/partners/{partnerId}": {
      "schema": "Partner",
      "description": "Collection storing partner profiles and folders"
    },
    "/contracts/{contractId}": {
      "schema": "Contract",
      "description": "Collection storing contract documents and metadata"
    },
    "/insertionOrders/{ioId}": {
      "schema": "InsertionOrder",
      "description": "Collection storing insertion order records"
    },
    "/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "Collection storing system activity and audit logs"
    }
  }
}
