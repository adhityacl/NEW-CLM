# 1. Dependencies
node_modules/
.pnp/
.pnp.js

# 2. Build Outputs
dist/
dist-ssr/
build/
.vite/

# 3. Databases & Runtime Data (SANGAT KRUSIAL: Berisi data login, token, & kredensial Google)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
auth.db
auth.db-wal
auth.db-shm
data_store.json
backups/

# 4. User Uploads & Documents (SANGAT KRUSIAL: Berisi PDF kontrak, due diligence & lampiran mitra)
uploads/*
!uploads/.gitkeep

# 5. Secrets, Environment Variables & Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*service-account*.json
*credentials*.json

# 6. Test Reports & Coverage
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# 7. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

